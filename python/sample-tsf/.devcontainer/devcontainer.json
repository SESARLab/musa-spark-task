{
    "dockerFile": "../../Dockerfile",
    "remoteUser": "${localEnv:USER}",
    "build": {
        "target": "devcontainer",
        "args": {
            "REMOTE_USER": "${localEnv:USER}",
            "REMOTE_UID": "${localEnv:REMOTE_UID:1000}",
            "REMOTE_GID": "${localEnv:REMOTE_GID:1000}"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.autopep8"
            ],
            "settings": {
                "editor.defaultFormatter": "ms-python.autopep8"
            }
        }
    }
}